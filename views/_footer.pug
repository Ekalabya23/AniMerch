footer.animaze-footer
      .footer-overlay
      .footer-container

        // Brand
        .footer-brand
          .logo.footer-logo
            i
            span AniMerch
          p Step into the world of anime collectibles, figures, and merch — crafted for true fans.

        // Links
        .footer-section
          h3 Explore
          ul
            li: a(href="/") Home
            li: a(href="/products") Shop
            li: a(href="/about") About
            li: a(href="/contact") Contact

        // Categories
        .footer-section
          h3 Genres
          ul
            li: a(href="/genre/action") Action
            li: a(href="/genre/fantasy") Fantasy
            li: a(href="/genre/romance") Romance
            li: a(href="/genre/comedy") Comedy

        // Newsletter
        .footer-newsletter
          h3 Join the Community
          form
            input(type="email" placeholder="Enter your email" required)
            button(type="submit") Join

      .footer-bottom
        p © 2025 AniMerch — All Rights Reserved
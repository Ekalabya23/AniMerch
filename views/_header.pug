header 
  .logo
    i
    span AniMerch

  nav.nav-cat 
    a.nav-btn(href='/category/New') New 
    a.nav-btn(href='/category/Apparel') Apparel 
    a.nav-btn(href='/category/Figures') Figures 
    a.nav-btn(href='/category/Accessories') Accessories 
    a.nav-btn(href='/category/Sale') Sale 
  
  if user
    .top-actions
      a.nav__el.cart(href='/myCarts', aria-label='Your cart')
        svg.cart-icon(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
          circle(cx="9" cy="21" r="1")
          circle(cx="20" cy="21" r="1")
          path(d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6")

      button.nav__el#navLogout(href='#') Log out
      a.nav__el(href='/me')
        img.nav__user-img(
          src=`${user.photo ? user.photo : `https://i.pravatar.cc/60?img=${Math.trunc(Math.random() * 30)}`}`,
          alt=`${user.name.split(' ')[0]} Image`
        )
        span= `${user.name.split(' ')[0]}`
  else 
    .top-actions
      a(href='/login' aria-label='Log In') Log in
      a.cta(href='/signup' aria-label='Sign in') Sign in

  script(defer src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js")
  script(src="/js/logout.js")

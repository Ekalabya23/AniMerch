doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Order Success | AniMerch
    link(rel="stylesheet", href="/css/paySucess.css")
    style.
      #fireworks {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1; /* keep canvas behind card */
      }
  body
    .success-container
      canvas#fireworks
      .card
        .icon
          i.fas.fa-check-circle
        h1 Congratulations 🎉
        p Your order has been placed successfully!
        p(style="opacity:0.8") Sit tight, we’ll ship your merch soon.
        a.btn(href="/") Continue Shopping

    // Fireworks.js script
    script(src="https://cdn.jsdelivr.net/npm/fireworks-js@2.10.5/dist/index.umd.js")
    script.
      document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("fireworks");

        // Correct UMD reference → Fireworks.default
        const FireworksConstructor = window.Fireworks.default;
        const fireworks = new FireworksConstructor(container, {
          autoresize: true,
          opacity: 0.5,
          acceleration: 1.05,
          friction: 0.97,
          gravity: 1.5,
          particles: 70,
          trace: 3,
          explosion: 5,
          intensity: 40,
          traceSpeed: 10,
          flickering: 50,
          lineStyle: "round",
          hue: { min: 0, max: 360 },
          delay: { min: 30, max: 60 },
          rocketsPoint: { min: 50, max: 50 },
          lineWidth: { explosion: { min: 1, max: 3 }, trace: { min: 1, max: 2 }}
        });

        fireworks.start();

        // Stop fireworks after 5s
        setTimeout(() => fireworks.stop(), 15000);
      });
